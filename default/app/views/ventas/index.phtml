<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Ventas</h2>
        <?= Html::linkAction('nuevo', 'Nueva Venta', 'class="btn btn-primary"') ?>
    </div>

    <?php View::content(); ?>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Folio (ID)</th>
                <th>Vendedor</th>
                <th>Cliente</th>
                <th class="text-end">Total</th>
                <th class="text-end">Por Pagar</th>
                <th class="text-center">Estado</th>
                <th>Fecha</th>

            </tr>
            </thead>
            <tbody>
            <?php if (count($ventas) > 0): ?>
                <?php foreach ($ventas as $v): ?>
                    <tr>
                        <td><?= $v->id ?></td>
                        <td><?= $v->obtener_vendedor() ? $v->obtener_vendedor()->email : 'N/A' ?></td>
                        <td><?= $v->obtener_cliente() ? $v->obtener_cliente()->nombre_completo() : 'Público General' ?></td>
                        <td class="text-end">$<?= number_format((float) $v->total, 2) ?></td>
                        <td class="text-end text-danger">$<?= number_format((float) $v->por_pagar, 2) ?></td>
                        <td class="text-center">
                            <?php if ($v->cerrada): ?>
                                <span class="badge bg-success">Cerrada</span>
                            <?php else: ?>
                                <span class="badge bg-warning text-dark">Abierta</span>
                            <?php endif; ?>
                        </td>
                        <td><?= date('d/m/Y H:i', strtotime($v->fecha)) ?></td>

                    </tr>
                <?php endforeach; ?>
            <?php else: ?>
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No hay ventas registradas.</td>
                </tr>
            <?php endif; ?>
            </tbody>
        </table>
    </div>
</div>