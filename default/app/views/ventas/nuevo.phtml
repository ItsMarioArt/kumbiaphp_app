<?php View::content(); ?>

<?php if (isset($usuarios)): ?>

    <!-- 1) Elegir el vendedor y el cliente de la venta -->
    <?= Myform::open("", "post", ["class" => "form-edicion"]) ?>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <?= Myform::select_label("Vendedor", "venta.usuario_id", $usuarios, [], null, "email") ?>
        </div>
        <div class="col-12 col-md-6">
            <?= Myform::select_label("Cliente", "venta.cliente_id", $clientes) ?>
        </div>
    </div>

    <div class="form-actions mt-3">
        <?= Myform::btn_aceptar("Crear venta") ?>
    </div>

    <?= Myform::close() ?>

<?php elseif (isset($venta)): ?>

    <div class="mx-auto text-start" style="max-width: 720px;">

        <!-- La venta abierta ya existe (o fue creada): sus datos -->
        <h3>Venta #<?= $venta->id ?></h3>
        <p class="mb-1">Vendedor: <?= $vendedor ? $vendedor->email : '—' ?></p>
        <p class="mb-1">Cliente: <?= $cliente ? $cliente->nombre_completo() : 'Público General' ?></p>
        <p>Fecha: <?= date('d/m/Y H:i', strtotime($venta->fecha)) ?></p>

        <!-- 2) Agregar un producto -->
        <?= Myform::open("", "post", ["class" => "form-edicion mt-4"]) ?>

        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-8">
                <?= Myform::select_label("Producto", "item.producto_id", $productos) ?>
            </div>
            <div class="col-12 col-md-4">
                <?= Myform::number_label("Cantidad", "item.cantidad", ["min" => "1"], "1") ?>
            </div>
        </div>

        <div class="form-actions mt-3">
            <?= Myform::btn_aceptar("Agregar") ?>
        </div>

        <?= Myform::close() ?>

        <!-- Renglones de la venta -->
        <table class="table table-sm align-middle mt-4">
            <thead>
            <tr>
                <th>Producto</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Unitario</th>
                <th class="text-end">Importe</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($items as $i): ?>
                <tr>
                    <td><?= $i->descripcion ?></td>
                    <td class="text-end"><?= $i->cantidad ?></td>
                    <td class="text-end">$<?= number_format((float) $i->unitario, 2) ?></td>
                    <td class="text-end">$<?= number_format((float) $i->importe, 2) ?></td>
                    <td class="text-end">
                        <?= Myform::open("ventas/quitar_item/{$venta->id}/{$i->id}") ?>
                        <?= Myform::btn_aceptar("Quitar", ["class" => "btn-sm btn-outline-danger"]) ?>
                        <?= Myform::close() ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            <?php if (!$items): ?>
                <tr>
                    <td colspan="5" class="text-muted text-center py-3">Todavía no hay productos en esta venta.</td>
                </tr>
            <?php endif; ?>
            </tbody>
            <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">$<?= number_format((float) $venta->total, 2) ?></th>
                <th></th>
            </tr>
            </tfoot>
        </table>

        <!-- 3) Finalizar la venta con el pago -->
        <?php if ($items): ?>
            <?php $total = number_format((float) $venta->total, 2, '.', ''); ?>

            <?= Myform::open("ventas/cerrar/{$venta->id}", "post", ["class" => "form-edicion mt-4"]) ?>
            <?= Myform::hidden("finalizar.venta", [], "1") ?>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <?= Myform::select_label("Método de pago", "finalizar.metodo_id", $metodos, [], null, "metodo") ?>
                </div>
                <div class="col-12 col-md-6">
                    <?= Myform::number_label("Monto", "finalizar.monto", ["min" => "0", "max" => $total, "step" => "0.01"], $total) ?>
                </div>
            </div>

            <div class="form-actions mt-3">
                <?= Myform::btn_aceptar("Finalizar venta") ?>
            </div>
            <?= Myform::close() ?>
        <?php endif; ?>

    </div>

<?php endif; ?>